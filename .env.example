# Copy to .env and adjust. Everything here is optional.

# Port on this machine (ignored with docker-compose.https.yml).
PONTAJ_PORT=3000

# Time zone for scheduled report emails.
TZ=UTC

# Only with docker-compose.https.yml: the domain Caddy gets a certificate for.
# PONTAJ_DOMAIN=time.example.com

# Unattended install: create the first account at first start instead of
# using the setup page. Ignored once an account exists.
# PONTAJ_USER=admin
# PONTAJ_PASS=change-me-at-least-10-chars

# Fix the site address instead of choosing it in the setup page.
# ORIGIN=https://time.example.com

# Language of the sign-in page and of new accounts (en, ro). Overrides the
# choice made in the setup page.
# PONTAJ_LANG=en
